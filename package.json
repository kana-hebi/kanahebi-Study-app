  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.26",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
